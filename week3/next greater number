#include <iostream>
#include <stack>
using namespace std;
void nextgreater(int arr[],int n)
{
	   int r[n];
    stack<int> s;

    for (int i = n - 1; i >= 0; i--)
    {
        // Remove all elements smaller than or equal to arr[i]
        while (!s.empty() && s.top() <= arr[i])
            s.pop();

        if (s.empty())
            r[i] = -1;
        else
            r[i] = s.top();

        s.push(arr[i]);
    }

    for (int i = 0; i < n; i++)
        cout << r[i] << " ";
}
int main()
{
    stack<int> s;
    int n;
    cout<<"enter size of array:";
    cin>>n;
    int a[n];
    for(int i=0;i<n;i++)
    {
    	cin>>a[i];
	}
	nextgreater(a,n);

    return 0;
}                                             
