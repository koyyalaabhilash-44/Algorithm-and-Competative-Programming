#include <iostream>
using namespace std;
void swap(int &x, int &y) {
    int temp = x;
    x = y;
    y = temp;
}
void reverse(int a[], int i, int j) {
    while (i < j) {
        swap(a[i], a[j]);
        i++;
        j--;
    }
}
void rotateArray(int a[], int n, int k) 
{
    k = k % n;
    reverse(a, 0, n - 1);
    reverse(a, 0, k - 1);
    reverse(a, k, n - 1);
}
int main() 
{
    int n, k;
    cout << "Enter number of elements: ";
    cin >> n;
    int a[100];
    cout << "Enter array elements: ";
    for(int i = 0; i < n; i++)
        cin >> a[i];
    cout << "Enter number of positions to rotate: ";
    cin >> k;
    rotateArray(a, n, k);
    cout << "Array after right rotation: ";
    for (int i = 0; i < n; i++)
        cout << a[i] << " ";
    return 0;
}
